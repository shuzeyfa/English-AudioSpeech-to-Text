# Copy to .env.local and fill in your keys. Never commit .env.local.

# Hugging Face access token (free) — https://huggingface.co/settings/tokens
# Create a fine-grained token with the "Inference Providers" permission.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Addis AI API key — https://addisassistant.com
# Used server-side only for English -> Amharic translation.
ADDIS_API_KEY=your_addis_ai_key_here
